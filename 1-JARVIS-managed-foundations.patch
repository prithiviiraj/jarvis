+.term-url:hover { background: rgba(52, 211, 153, 0.18); }
+.term-url::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #34d399; }
+.term-view { flex: 1; min-height: 0; display: flex; flex-direction: column; }
+.term-view[hidden] { display: none; }
+#term-shells { display: contents; }
+.term-host { flex: 1; min-height: 0; padding: 8px 4px 4px 10px; background: #0b0c0c; }
+.term-host .xterm { height: 100%; }
