+.term-menu[hidden] { display: none; }
+.term-menu button { height: 28px; padding: 0 10px; border: 0; border-radius: 6px; background: transparent; color: var(--text-1); font: 12px var(--font); text-align: left; cursor: pointer; }
+.term-menu button:hover { background: var(--accent); }
+.term-urls { display: flex; gap: 6px; flex: none; }
