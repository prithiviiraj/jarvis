+        <section data-pane="voice" hidden>
+          <div class="group">
+            <div class="row"><div class="label">Speak replies out loud<div class="hint" id="speak-hint"></div></div><div class="control"><label class="switch"><input type="checkbox" id="speak"><span class="track"></span></label></div></div>
+          </div>
+
+          <div class="section-label">Voice</div>
+          <div class="group">
+            <div class="row stack"><div id="voices"></div><div class="caption" id="preview-msg">Built in and private: speech is made on this PC. Press ▶&#xFE0E; to hear a voice.</div></div>
+            <div class="row"><div class="label">Speed</div><div class="control"><span class="caption">Slower</span><input type="range" id="rate" min="0.7" max="1.4" step="0.05"><span class="caption">Faster</span></div></div>
+          </div>
+
+          <div class="section-label">Speech recognition</div>
+          <div class="group">
+            <div class="row"><div class="label">Recognize speech<div class="hint">Whisper on this PC · private, works offline</div></div></div>
+          </div>
+
+          <div class="section-label">Microphone</div>
+          <div class="group">
+            <div class="row"><div class="label">Access<div class="hint" id="mic-hint"></div></div>
+              <div class="control"><span class="status" id="mic-status"><span class="dot"></span><span class="text">Checking…</span></span></div></div>
+            <div class="row"><div class="label"><div class="meter" id="mic-meter"></div></div>
+              <div class="control"><button class="btn plain small" id="mic-settings">Windows Settings…</button><button class="btn secondary small" id="mic-test">Test Microphone</button></div></div>
+          </div>
+        </section>
+
+        <!-- General -->
+        <section data-pane="general" hidden>
+          <div class="group">
+            <div class="row"><div class="label">Sound effects</div><div class="control"><label class="switch"><input type="checkbox" id="sounds"><span class="track"></span></label></div></div>
+            <div class="row"><div class="label">Open at login</div><div class="control"><label class="switch"><input type="checkbox" id="login"><span class="track"></span></label></div></div>
+            <div class="row"><div class="label">Tool tray<div class="hint">Double-click an empty spot on the desktop to pick a tool</div></div><div class="control"><label class="switch"><input type="checkbox" id="tool-tray"><span class="track"></span></label></div></div>
+          </div>
+          <div class="section-label">Plugins</div>
+          <div class="group" id="plugin-list"></div>
+          <div class="plugin-actions">
+            <a id="open-plugins">Open plugins folder</a>
+            <span class="spacer"></span>
+            <button class="btn secondary small" id="plugin-add">Add Plugin…</button>
+          </div>
+          <div class="plugin-review" id="plugin-review" hidden></div>
+
+          <div class="section-label">Activity</div>
+          <div class="group">
+            <div class="row"><div class="label">Activity log</div><div class="control"><button class="btn secondary small" id="open-logs">Show Logs</button></div></div>
+          </div>
+          <div class="about"><img src="assets/icon.png" width="40" height="40" alt=""><div><div class="headline">Bigfoot</div><div class="caption" id="version"></div></div></div>
+        </section>
+      </div>
+    </main>
+  </div>
+  <script src="ui.js"></script>
+  <script src="local-ai.js"></script>
+  <script src="app.js"></script>
+  <script src="home.js"></script>
+  <script src="terminal-pane.js"></script>
+  <script src="../../node_modules/@xterm/xterm/lib/xterm.js"></script>
