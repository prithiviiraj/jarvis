+from .local_model_files import download_checked,extract_runtime,verify_runtime_receipt
+class ModelManager:
+ def __init__(self,root,scan=None,download=None,extract=None):
+  self.root=pathlib.Path(root);self.scan=scan or detect_hardware;self.download=download or download_checked;self.extract=extract or extract_runtime;self.lock=threading.RLock();self.cancel=threading.Event();self.worker=None;self.hardware=None;self.choices=None;self.pending=None;self.status='Not checked';self.error='';self.progress={};self.installed=[]
