new file mode 100644
index 0000000..26ff737
--- /dev/null
+++ b/third-party/bigfoot/local-reference/download.js
@@ -0,0 +1,117 @@
+'use strict';
+// Resumable download (HTTP Range into a .part file) and SHA-256 verification.
+
+const crypto = require('crypto');
+const fs = require('fs');
+
+const STALL_MS = 45000;
+
+class DownloadError extends Error {
+  constructor(message, { retryable = true, status = 0, code = '' } = {}) {
+    super(message);
+    this.retryable = retryable;
+    this.status = status;
+    this.code = code;
+  }
+}
+
+async function sizeOf(file) {
+  try { return (await fs.promises.stat(file)).size; } catch { return 0; }
+}
+
+async function downloadFile({ url, dest, size, signal, onBytes = () => {}, stallMs = STALL_MS, fetchImpl = fetch }) {
+  let start = await sizeOf(dest);
+  if (start > size) { await fs.promises.truncate(dest, 0); start = 0; }
+  if (start === size) return;
+
+  const stall = new AbortController();
+  let stallTimer = null;
+  const armStall = () => {
+    clearTimeout(stallTimer);
+    stallTimer = setTimeout(() => stall.abort(), stallMs);
+  };
+  const both = signal ? AbortSignal.any([signal, stall.signal]) : stall.signal;
+
+  let res;
+  armStall();
+  try {
+    res = await fetchImpl(url, {
+      headers: start > 0 ? { Range: `bytes=${start}-` } : {},
+      signal: both,
+      redirect: 'follow',
+    });
+  } catch (err) {
+    clearTimeout(stallTimer);
+    if (signal && signal.aborted) throw err;
+    throw new DownloadError(stall.signal.aborted ? 'The connection stalled.' : 'Couldn’t reach the download server.', { code: 'network' });
+  }
+
+  if (res.status === 416) {
+    clearTimeout(stallTimer);
+    await drain(res);
+    if (start === size) return;
+    await fs.promises.truncate(dest, 0);
+    throw new DownloadError('The partial file didn’t match the server. Starting that file again.', { code: 'range' });
+  }
+  if (!res.ok) {
+    clearTimeout(stallTimer);
+    await drain(res);
+    const retryable = res.status >= 500 || res.status === 429 || res.status === 408;
+    throw new DownloadError(`The download server returned ${res.status}.`, { retryable, status: res.status, code: 'http' });
+  }
+
+  let append = false;
+  if (start > 0 && res.status === 206) {
+    const m = /bytes\s+(\d+)-/i.exec(res.headers.get('content-range') || '');
+    append = Boolean(m && Number(m[1]) === start);
+  }
+  if (!append) start = 0; // server ignored Range
+
+  const fh = await fs.promises.open(dest, append ? 'a' : 'w');
+  let written = start;
+  try {
+    const reader = res.body.getReader();
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      armStall();
+      await fh.write(value);
+      written += value.length;
+      onBytes(value.length, written);
+      if (written > size) throw new DownloadError('The server sent more data than expected.', { retryable: false, code: 'size' });
+    }
+  } catch (err) {
+    if (signal && signal.aborted) throw err;
+    if (err instanceof DownloadError) throw err;
+    if (err && err.code === 'ENOSPC') throw new DownloadError('Your disk is full. Free up some space, then retry.', { retryable: false, code: 'disk' });
+    throw new DownloadError(stall.signal.aborted ? 'The connection stalled.' : 'The connection dropped.', { code: 'network' });
+  } finally {
+    clearTimeout(stallTimer);
+    await fh.close();
+  }
+  if (written < size) throw new DownloadError('The connection closed early.', { code: 'network' });
+}
+
+async function drain(res) {
+  try { await res.arrayBuffer(); } catch { /* ignore */ }
+}
+
+function sha256File(file, { onBytes = () => {}, signal } = {}) {
+  return new Promise((resolve, reject) => {
+    const hash = crypto.createHash('sha256');
+    const stream = fs.createReadStream(file, { highWaterMark: 4 * 1024 * 1024 });
+    const abort = () => { stream.destroy(); reject(Object.assign(new Error('Aborted'), { name: 'AbortError' })); };
+    if (signal) {
+      if (signal.aborted) return abort();
+      signal.addEventListener('abort', abort, { once: true });
+    }
+    stream.on('data', (chunk) => { hash.update(chunk); onBytes(chunk.length); });
+    stream.on('error', reject);
+    stream.on('end', () => {
+      if (signal) signal.removeEventListener('abort', abort);
+      resolve(hash.digest('hex'));
+    });
+  });
+}
+
+module.exports = { downloadFile, sha256File, DownloadError, STALL_MS };
diff --git a/third-party/bigfoot/local-reference/hardware.js b/third-party/bigfoot/local-reference/hardware.js
new file mode 100644
index 0000000..a69c41d
--- /dev/null
+++ b/third-party/bigfoot/local-reference/hardware.js
@@ -0,0 +1,79 @@
+'use strict';
+// RAM, best GPU and its VRAM, free disk. VRAM comes from the registry (WMI's AdapterRAM caps at 4 GB)
+// or nvidia-smi when available.
+
+const { execFile } = require('child_process');
+const fs = require('fs');
+const os = require('os');
+
+const GB = 1024 ** 3;
+const DISPLAY_CLASS = 'HKLM\\SYSTEM\\CurrentControlSet\\Control\\Class\\{4d36e968-e325-11ce-bfc1-08002be10318}';
+const IGNORED = /basic display|basic render|remote display|virtual|parsec|citrix|hyper-v|idd/i;
+
+function run(file, args, timeout = 8000) {
+  return new Promise((resolve) => {
+    execFile(file, args, { windowsHide: true, timeout }, (err, stdout) => resolve(err ? '' : String(stdout)));
+  });
+}
+
+function parseReg(text) {
+  const keys = {};
+  let current = null;
+  for (const line of String(text).split(/\r?\n/)) {
+    if (/^HKEY_/.test(line)) { current = keys[line.trim()] = {}; continue; }
+    const m = /^\s{2,}(.+?)\s{2,}(REG_\w+)\s{2,}(.*)$/.exec(line);
+    if (m && current) current[m[1]] = m[2] === 'REG_QWORD' || m[2] === 'REG_DWORD' ? Number(BigInt(m[3].trim())) : m[3].trim();
+  }
+  return keys;
+}
+
+function adaptersFromReg(text) {
+  return Object.values(parseReg(text))
+    .filter((v) => v.DriverDesc && !IGNORED.test(v.DriverDesc))
+    .map((v) => {
+      const bytes = Number(v['HardwareInformation.qwMemorySize']) || Number(v['HardwareInformation.MemorySize']) || 0;
+      const vendor = /ven_([0-9a-f]{4})/i.exec(v.MatchingDeviceId || '');
+      return { name: v.DriverDesc, vramGB: bytes / GB, vendor: vendor ? vendor[1].toLowerCase() : '' };
+    })
+    .sort((a, b) => b.vramGB - a.vramGB);
+}
+
+function adaptersFromNvidiaSmi(text) {
+  return String(text).split(/\r?\n/).map((l) => l.split(',').map((s) => s.trim())).filter((p) => p.length >= 2 && p[0])
+    .map(([name, mib]) => ({ name, vramGB: (Number(mib) || 0) / 1024, vendor: '10de' }));
+}
+
+async function freeDiskGB(dir) {
+  try {
+    const s = await fs.promises.statfs(dir);
+    return (s.bavail * s.bsize) / GB;
+  } catch {
+    return null;
+  }
+}
+
+async function detect(dataDir) {
+  const [reg, smi, disk] = await Promise.all([
+    process.platform === 'win32' ? run('reg', ['query', DISPLAY_CLASS, '/s']) : '',
+    process.platform === 'win32' ? run('nvidia-smi', ['--query-gpu=name,memory.total', '--format=csv,noheader,nounits']) : '',
+    freeDiskGB(dataDir || os.homedir()),
+  ]);
+  const adapters = [...adaptersFromNvidiaSmi(smi), ...adaptersFromReg(reg)]
+    .filter((a, i, all) => all.findIndex((b) => b.name === a.name) === i)
+    .sort((a, b) => b.vramGB - a.vramGB);
+  const best = adapters[0] || null;
+  const dedicated = Boolean(best && best.vramGB >= 2);
+  const cpus = os.cpus();
+  return {
+    gpu: best ? best.name : 'No dedicated GPU',
+    vramGB: dedicated ? round(best.vramGB) : 0,
+    dedicated,
+    ramGB: round(os.totalmem() / GB),
+    freeDiskGB: disk == null ? null : round(disk),
+    cpu: cpus.length ? `${cpus[0].model.trim()} · ${cpus.length} threads` : '',
+  };
+}
+
+function round(n) { return Math.round(n * 10) / 10; }
+
+module.exports = { detect, parseReg, adaptersFromReg, adaptersFromNvidiaSmi };
