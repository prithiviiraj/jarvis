diff --git a/.github/workflows/managed-model-proof.yml b/.github/workflows/managed-model-proof.yml
new file mode 100644
index 0000000..938a4f3
--- /dev/null
+++ b/.github/workflows/managed-model-proof.yml
@@ -0,0 +1,28 @@
+name: JARVIS owned Windows model proof
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  model-proof:
+    runs-on: windows-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: Install diagnostic image dependency
+        run: python -m pip install Pillow==11.3.0
+      - name: Actual pinned Windows runtime and synthetic text/image generation
+        shell: pwsh
+        run: |
+          python modern-ui/managed-model-proof.py
+          if ($LASTEXITCODE -ne 0) { throw 'Actual managed model proof failed' }
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: JARVIS-managed-model-diagnostic-evidence
+          path: managed-proof-evidence
+          retention-days: 7
+          if-no-files-found: error
