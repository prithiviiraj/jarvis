+++ b/modern-ui/public/bigfoot-ui/app.css
@@ -0,0 +1,181 @@
+/* Main window: layout for Home and Terminal, plus the responsive sidebar. */
+
+.nav-sep { height: 1px; margin: 8px 8px; background: var(--hairline); font-size: 0; }
+.nav-sep:not(:empty) {
+  height: auto; background: none; margin: 12px 8px 4px; font-size: 10.5px; font-weight: 600;
+  letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-3);
+}
+
+.pane.fill { overflow: hidden; display: flex; flex-direction: column; padding-bottom: 20px; }
+.pane.fill > section:not([hidden]) { flex: 1; min-height: 0; display: flex; flex-direction: column; width: 100%; max-width: 760px; }
+
+/* Home */
+.home { gap: 10px; }
+.chat-head { display: flex; align-items: center; gap: 8px; }
+.chat-head .spacer { flex: 1; }
+.chat-head .btn svg { margin-right: 2px; }
+.home .setup {
+  display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; border-radius: var(--r-lg);
+  background: linear-gradient(180deg, rgba(37, 99, 235, 0.14), rgba(37, 99, 235, 0.04)); border: 1px solid rgba(51, 128, 255, 0.3);
+}
+
+.home .log { flex: 1; min-height: 120px; padding: 8px 4px 16px; display: flex; flex-direction: column; gap: 14px; }
+.home .empty { margin: auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px; }
+.empty-title { font-size: 20px; font-weight: 650; letter-spacing: -0.015em; color: var(--text-1); }
+.empty-mark { opacity: 0.95; animation: float 4s ease-in-out infinite; }
+@keyframes float { 50% { transform: translateY(-5px); } }
+
+.turn { display: flex; gap: 10px; animation: msg-in 240ms var(--ease); }
+@keyframes msg-in { from { opacity: 0; transform: translateY(4px); } }
+.turn.user { justify-content: flex-end; }
+.turn .avatar { flex: none; width: 24px; height: 24px; margin-top: 1px; border-radius: 7px; padding: 4px; background: linear-gradient(#ffffff, #e7ebf0); }
+.msg { font-size: 14px; line-height: 1.6; user-select: text; white-space: pre-wrap; overflow-wrap: anywhere; }
+.msg.user { max-width: 80%; padding: 9px 14px; border-radius: 16px; background: var(--surface-3); border: 1px solid var(--hairline); }
+.ai-loading { margin: 10px 16px 0; padding: 10px 12px; border-radius: 12px; background: var(--surface-2, rgba(255, 255, 255, 0.04)); border: 1px solid var(--hairline); }
+.ai-loading[hidden] { display: none; }
+.ail-head { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; }
+.ail-head span:nth-child(2) { flex: 1; min-width: 0; }
+.ail-dot { width: 10px; height: 10px; border-radius: 50%; box-sizing: border-box; border: 2px solid rgba(51, 128, 255, 0.25); border-top-color: #3380ff; animation: spin 0.8s linear infinite; }
+.ai-loading[data-state='failed'] .ail-dot { animation: none; background: var(--danger, #ff453a); border-color: var(--danger, #ff453a); }
+.ail-pct { color: var(--text-2, #8f969c); font-variant-numeric: tabular-nums; }
+.ail-track { height: 3px; margin: 8px 0 6px; border-radius: 2px; background: var(--hairline); overflow: hidden; }
+.ai-loading[data-state='failed'] .ail-track { display: none; }
+.ail-track i { display: block; height: 100%; width: 0; background: #3380ff; border-radius: 2px; transition: width 900ms cubic-bezier(0.22, 1, 0.36, 1); }
+.ail-note { font-size: 12px; color: var(--text-2, #8f969c); }
+.msg-image { display: block; max-width: 100%; max-height: 220px; margin: -3px -8px 8px; border-radius: 10px; border: 1px solid var(--hairline); object-fit: contain; background: var(--surface-2, #111); }
+.msg.assistant { flex: 1; min-width: 0; padding-top: 2px; color: var(--text-1); }
+.msg.typing { display: flex; gap: 4px; align-items: center; height: 26px; }
+.msg.typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--text-3); animation: typing 1.2s ease-in-out infinite; }
+.msg.typing i:nth-child(2) { animation-delay: 0.15s; }
+.msg.typing i:nth-child(3) { animation-delay: 0.3s; }
+@keyframes typing { 30% { transform: translateY(-4px); background: var(--text-2); } }
+.steps { margin-left: 34px; display: flex; flex-direction: column; gap: 3px; border-left: 2px solid var(--hairline); padding-left: 10px; }
+.step { font-size: 12px; color: var(--text-3); line-height: 1.5; }
+.step.progress { color: var(--text-2); font-style: italic; }
+.step.error { color: var(--danger-text); }
+
+.region-chip {
+  display: flex; align-items: center; gap: 7px; padding: 6px 6px 6px 12px; border-radius: 10px;
+  background: rgba(51, 128, 255, 0.1); border: 1px solid rgba(51, 128, 255, 0.35); color: var(--accent-text); font-size: 12px; font-weight: 550;
+}
+.rc-icon { width: 12px; height: 9px; border: 1.5px dashed currentColor; border-radius: 3px; }
+.region-chip #region-text { flex: 1; }
+.rc-clear { width: 22px; height: 22px; border: 0; border-radius: 50%; background: transparent; color: var(--text-2); display: flex; align-items: center; justify-content: center; }
+.rc-clear:hover { background: rgba(255, 255, 255, 0.08); color: var(--text-1); }
+.rc-clear svg { width: 10px; height: 10px; }
+
+.composer {
+  display: flex; align-items: flex-end; gap: 8px; padding: 7px 7px 7px 14px; border-radius: 20px;
+  background: var(--surface-2); border: 1px solid var(--border-subtle); transition: border-color var(--fast), box-shadow var(--fast);
+}
+.composer:focus-within { border-color: var(--buddy); box-shadow: 0 0 0 3px rgba(51, 128, 255, 0.2); }
+.composer textarea { flex: 1; resize: none; border: 0; background: transparent; padding: 6px 0; max-height: 120px; font-size: 13.5px; line-height: 1.4; user-select: text; overflow-y: auto; }
+.composer textarea::placeholder { color: var(--text-3); }
+.send { flex: none; width: 30px; height: 30px; border-radius: 50%; border: 0; padding: 0; display: flex; align-items: center; justify-content: center; color: #fff; background: var(--accent); transition: transform 100ms, background var(--fast); }
+.send:active { transform: scale(0.92); }
+.send:disabled { background: var(--surface-4); color: var(--text-3); }
+.send svg { width: 16px; height: 16px; }
+.send .i-stop { display: none; }
+body.running .send { background: var(--surface-4); color: var(--text-1); }
+body.running .send:disabled { opacity: 1; }
+body.running .send .i-send { display: none; }
+body.running .send .i-stop { display: block; }
+
+/* Models */
+.banner-slot { flex: none; padding: 0 28px; }
+.banner-slot:not([hidden]) { display: flex; justify-content: center; }
+.banner-slot > * { width: 100%; max-width: 760px; }
+.section-label.first { margin-top: 4px; }
+.section-label .optional { margin-left: 6px; padding: 1px 7px; border-radius: 8px; font-size: 10px; letter-spacing: 0.02em; text-transform: none;
+  color: var(--text-2); background: var(--surface-3); }
+.keep-group { margin-top: 10px; }
+.local-foot { display: flex; align-items: center; gap: 8px; margin: 8px 2px 0; font-size: 12px; }
+.local-foot .spacer { flex: 1; }
+.cloud-note { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 8px; padding: 10px 12px; border-radius: var(--r-lg);
+  font-size: 12px; line-height: 1.45; color: #f5d08a; background: rgba(255, 178, 36, 0.08); border: 1px solid rgba(255, 178, 36, 0.3); }
+.warn-icon { flex: none; width: 16px; height: 16px; margin-top: 1px; border-radius: 50%; background: var(--warning) no-repeat center / 10px;
