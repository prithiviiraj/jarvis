index 52efd3a..c0523a1 100644
--- a/src/phonemis/lang/en/lexicon_phonemizer.cpp
+++ b/src/phonemis/lang/en/lexicon_phonemizer.cpp
@@ -100,6 +100,21 @@ void LexiconPhonemizer::update_context(size_t curr_token_id, std::span<const Tok
       } else {
         global_context_.vowel_next = std::nullopt;
       }
+      // Changed for JARVIS evaluation: acronym pronunciation, not spelling,
+      // determines article vowel context (FBI starts /e/, USA starts /j/).
+      if (strings::is_all_upper(next_token.text)) {
+        auto phones = lookup_nnp(next_token.text);
+        for (char32_t phone : phones) {
+          if (constants::ipa::kVowels.contains(phone)) {
+            global_context_.vowel_next = true;
+            break;
+          }
+          if (constants::ipa::kConsonants.contains(phone)) {
+            global_context_.vowel_next = false;
+            break;
+          }
+        }
+      }
     }
   }
 
