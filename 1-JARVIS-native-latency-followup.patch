diff --git a/src/jarvis/latency_profiles.py b/src/jarvis/latency_profiles.py
new file mode 100644
index 0000000..a578916
--- /dev/null
+++ b/src/jarvis/latency_profiles.py
@@ -0,0 +1,11 @@
+"""Diagnostic-only startup comparisons. Never select a shipping profile here."""
+import subprocess
+class DiagnosticProfile:
+ def __init__(self,context,spawn=None):
+  if context not in (4096,8192):raise ValueError('Only bounded diagnostic context sizes')
+  self.context=context;self.spawn=spawn or subprocess.Popen
+ def __call__(self,args,**kwargs):
+  args=list(args)
+  if args.count('--ctx-size')!=1 or args.count('--api-key')!=1:raise ValueError('Unexpected owned runtime argument contract')
+  args[args.index('--ctx-size')+1]=str(self.context)
+  return self.spawn(args,**kwargs)
diff --git a/tests/test_latency_profiles.py b/tests/test_latency_profiles.py
new file mode 100644
index 0000000..5632edc
--- /dev/null
+++ b/tests/test_latency_profiles.py
@@ -0,0 +1,13 @@
+import unittest
+from unittest.mock import Mock
+from jarvis.latency_profiles import DiagnosticProfile
+class Tests(unittest.TestCase):
+ def test_only_context_changes_no_shipping_default(self):
+  original=['llama-server.exe','--ctx-size','8192','--api-key','fixture','--host','127.0.0.1','--mmproj','fixture.gguf'];spawn=Mock();profile=DiagnosticProfile(4096,spawn);profile(original,cwd='fixture');new=spawn.call_args.args[0]
+  self.assertEqual(original[2],'8192');self.assertEqual(new,original[:2]+['4096']+original[3:]);self.assertEqual(spawn.call_args.kwargs,{'cwd':'fixture'})
+ def test_unknown_profile_rejected(self):
+  with self.assertRaises(ValueError):DiagnosticProfile(2048)
+ def test_missing_contract_does_not_spawn(self):
+  spawn=Mock()
+  with self.assertRaises(ValueError):DiagnosticProfile(4096,spawn)(['fixture'])
+  spawn.assert_not_called()
