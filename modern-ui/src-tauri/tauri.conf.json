{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS Modern Preview",
  "version": "0.1.0",
  "identifier": "dev.jarvis.modern.preview",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JARVIS / Modern workspace preview",
        "width": 1220,
        "height": 780,
        "minWidth": 780,
        "minHeight": 600,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
